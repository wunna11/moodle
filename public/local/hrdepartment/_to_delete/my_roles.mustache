{{!
    @template local_hrdepartment/my_roles

    "My roles" self-service section: every Moodle role the current user
    holds and where (system-wide, a course, their own profile, or - for a
    delegated student-leave Approver - another user's profile).

    Example context (json):
    {
        "hasroles": true,
        "roles": [
            {"rolename": "Manager", "contextname": "System", "hasurl": false, "contexturl": null},
            {"rolename": "Approver", "contextname": "User: Jane Student", "hasurl": true, "contexturl": "https://example.com/user/profile.php?id=5"}
        ]
    }
}}
<div class="local-hrdepartment-my-roles card mb-3">
    <div class="card-header">{{#str}}myroles, local_hrdepartment{{/str}}</div>

    {{^hasroles}}
    <div class="card-body text-muted">{{#str}}norolesassigned, local_hrdepartment{{/str}}</div>
    {{/hasroles}}

    {{#hasroles}}
    <table class="table table-sm mb-0">
        <thead>
            <tr>
                <th>{{#str}}role, local_hrdepartment{{/str}}</th>
                <th>{{#str}}rolecontext, local_hrdepartment{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#roles}}
            <tr>
                <td>{{rolename}}</td>
                <td>
                    {{#hasurl}}<a href="{{contexturl}}">{{contextname}}</a>{{/hasurl}}
                    {{^hasurl}}{{contextname}}{{/hasurl}}
                </td>
            </tr>
            {{/roles}}
        </tbody>
    </table>
    {{/hasroles}}
</div>
