{{!
    @template local_hrdepartment/staff_profile

    A single staff member's profile: contact and employment details.
    No academic details or course assignments card - staff have neither.

    Example context (json):
    {
        "fullname": "John Smith",
        "email": "john@example.com",
        "employeecode": "EMP-0099",
        "departmentname": "Finance",
        "designation": "Accounts Officer",
        "employmentstatus": "Active",
        "isactive": true,
        "phone": "+1 555 0200",
        "emergencycontact": "+1 555 0299",
        "address": "45 Campus Way",
        "joindate": "3 Mar 2025",
        "editurl": "#",
        "deactivateurl": "#",
        "reactivateurl": "#"
    }
}}
<div class="local-hrdepartment-staff-profile">

    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h3 class="mb-0">{{fullname}}</h3>
            <div class="text-muted">{{email}} &middot; {{employeecode}}</div>
        </div>
        <div>
            <a href="{{editurl}}" class="btn btn-secondary">{{#str}}edit{{/str}}</a>
            {{#isactive}}
            <a href="{{deactivateurl}}" class="btn btn-outline-danger">{{#str}}deactivate, local_hrdepartment{{/str}}</a>
            {{/isactive}}
            {{^isactive}}
            <a href="{{reactivateurl}}" class="btn btn-outline-success">{{#str}}reactivate, local_hrdepartment{{/str}}</a>
            {{/isactive}}
        </div>
    </div>

    <div class="card">
        <div class="card-header">{{#str}}profiledetails, local_hrdepartment{{/str}}</div>
        <table class="table table-sm mb-0">
            <tbody>
                <tr><th scope="row">{{#str}}department, local_hrdepartment{{/str}}</th><td>{{departmentname}}</td></tr>
                <tr><th scope="row">{{#str}}designation, local_hrdepartment{{/str}}</th><td>{{designation}}</td></tr>
                <tr><th scope="row">{{#str}}employmentstatus, local_hrdepartment{{/str}}</th><td>{{employmentstatus}}</td></tr>
                <tr><th scope="row">{{#str}}joindate, local_hrdepartment{{/str}}</th><td>{{joindate}}</td></tr>
                <tr><th scope="row">{{#str}}phone, local_hrdepartment{{/str}}</th><td>{{phone}}</td></tr>
                <tr><th scope="row">{{#str}}emergencycontact, local_hrdepartment{{/str}}</th><td>{{emergencycontact}}</td></tr>
                <tr><th scope="row">{{#str}}address, local_hrdepartment{{/str}}</th><td>{{address}}</td></tr>
            </tbody>
        </table>
    </div>

</div>
