{{!
    @template local_hrdepartment/my_summary

    Personal "My HR" snapshot shown to self-service users who don't hold
    the org-wide dashboard capability: a welcome hero, this month's
    attendance, leave balances, pending leave applications, and the
    latest payslip.

    Example context (json):
    {
        "herogreeting": "Welcome back, Jane Lecturer",
        "herosubtitle": "Here is your personal HR snapshot.",
        "herodate": "Monday, 17 August 2026",
        "hasprofile": true,
        "employeecode": "EMP-0042",
        "designation": "Lecturer",
        "attendancepresent": 18,
        "attendanceabsent": 1,
        "attendanceleave": 2,
        "attendancehalfday": 0,
        "hasleavebalances": true,
        "leavebalances": [
            {"leavetypename": "Annual Leave", "allocated": 18, "used": 4, "remaining": 14}
        ],
        "pendingleave": 1,
        "haslatestpayroll": true,
        "latestpayroll": {"period": "2026-07", "netsalary": "1,950.00", "currency": "USD", "paymentstatus": "Paid", "paymentstatusclass": "hrdept-pill-paid"}
    }
}}
<div class="local-hrdepartment-my-summary">

    <div class="hrdept-dashboard-hero">
        <div class="hrdept-dashboard-hero-text">
            <h2 class="hrdept-dashboard-hero-title">{{herogreeting}}</h2>
            <p class="hrdept-dashboard-hero-subtitle">{{herosubtitle}}</p>
        </div>
        <div class="hrdept-dashboard-hero-date">{{herodate}}</div>
    </div>

    {{^hasprofile}}
    <div class="hrdept-summary-card">
        <div class="hrdept-empty-state">
            <i class="icon fa fa-user-slash" aria-hidden="true"></i>
            {{#str}}noemployeerecord, local_hrdepartment{{/str}}
        </div>
    </div>
    {{/hasprofile}}

    {{#hasprofile}}
    <div class="hrdept-my-meta">
        <span class="hrdept-pill hrdept-pill-neutral">{{#str}}employeecode, local_hrdepartment{{/str}}: {{employeecode}}</span>
        {{#designation}}<span class="hrdept-pill hrdept-pill-neutral">{{designation}}</span>{{/designation}}
    </div>

    <div class="row">
        <div class="col-lg-4 mb-3">
            <div class="hrdept-summary-card h-100">
                <div class="hrdept-summary-card-header">
                    <span class="hrdept-summary-card-title">
                        <i class="icon fa fa-clipboard-check" aria-hidden="true"></i>
                        {{#str}}myattendancethismonth, local_hrdepartment{{/str}}
                    </span>
                </div>
                <div class="hrdept-summary-card-body">
                    <table class="table table-sm mb-0">
                        <tbody>
                            <tr>
                                <th scope="row">{{#str}}attendance_present, local_hrdepartment{{/str}}</th>
                                <td class="text-right">{{attendancepresent}}</td>
                            </tr>
                            <tr>
                                <th scope="row">{{#str}}attendance_absent, local_hrdepartment{{/str}}</th>
                                <td class="text-right">{{attendanceabsent}}</td>
                            </tr>
                            <tr>
                                <th scope="row">{{#str}}attendance_leave, local_hrdepartment{{/str}}</th>
                                <td class="text-right">{{attendanceleave}}</td>
                            </tr>
                            <tr>
                                <th scope="row">{{#str}}attendance_halfday, local_hrdepartment{{/str}}</th>
                                <td class="text-right">{{attendancehalfday}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-3">
            <div class="hrdept-summary-card h-100">
                <div class="hrdept-summary-card-header">
                    <span class="hrdept-summary-card-title">
                        <i class="icon fa fa-calendar-alt" aria-hidden="true"></i>
                        {{#str}}myleavebalance, local_hrdepartment{{/str}}
                    </span>
                    <span class="hrdept-pill hrdept-pill-pending">{{#str}}pendingleave, local_hrdepartment{{/str}}: {{pendingleave}}</span>
                </div>
                {{#hasleavebalances}}
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>{{#str}}leavetype, local_hrdepartment{{/str}}</th>
                            <th class="text-right">{{#str}}allocated, local_hrdepartment{{/str}}</th>
                            <th class="text-right">{{#str}}used, local_hrdepartment{{/str}}</th>
                            <th class="text-right">{{#str}}remaining, local_hrdepartment{{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#leavebalances}}
                        <tr>
                            <td>{{leavetypename}}</td>
                            <td class="text-right">{{allocated}}</td>
                            <td class="text-right">{{used}}</td>
                            <td class="text-right">{{remaining}}</td>
                        </tr>
                        {{/leavebalances}}
                    </tbody>
                </table>
                {{/hasleavebalances}}
                {{^hasleavebalances}}
                <div class="hrdept-summary-card-body text-muted">{{#str}}noleavebalance, local_hrdepartment{{/str}}</div>
                {{/hasleavebalances}}
            </div>
        </div>

        <div class="col-lg-4 mb-3">
            <div class="hrdept-summary-card h-100">
                <div class="hrdept-summary-card-header">
                    <span class="hrdept-summary-card-title">
                        <i class="icon fa fa-money-bill-wave" aria-hidden="true"></i>
                        {{#str}}mylatestpayslip, local_hrdepartment{{/str}}
                    </span>
                </div>
                <div class="hrdept-summary-card-body">
                    {{#haslatestpayroll}}
                    <div class="hrdept-payroll-net hrdept-payroll-net-compact">
                        <span class="hrdept-payroll-net-value">{{latestpayroll.currency}} {{latestpayroll.netsalary}}</span>
                        <span class="hrdept-payroll-net-label">{{latestpayroll.period}}</span>
                    </div>
                    <span class="hrdept-pill {{latestpayroll.paymentstatusclass}}">{{latestpayroll.paymentstatus}}</span>
                    {{/haslatestpayroll}}
                    {{^haslatestpayroll}}
                    <div class="text-muted">{{#str}}nopayrollrecord, local_hrdepartment{{/str}}</div>
                    {{/haslatestpayroll}}
                </div>
            </div>
        </div>
    </div>
    {{/hasprofile}}

</div>
