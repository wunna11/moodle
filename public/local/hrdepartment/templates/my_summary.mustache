{{!
    @template local_hrdepartment/my_summary

    Personal "My HR" snapshot shown to self-service users who don't hold
    the org-wide dashboard capability: this month's attendance, leave
    balances, pending leave applications, and the latest payslip.

    Example context (json):
    {
        "hasprofile": true,
        "employeecode": "EMP-0042",
        "designation": "Lecturer",
        "attendancepresent": 18,
        "attendanceabsent": 1,
        "attendanceleave": 2,
        "attendancehalfday": 0,
        "hasleavebalances": true,
        "leavebalances": [
            {"leavetypename": "Annual Leave", "allocated": 18, "used": 4, "remaining": 14}
        ],
        "pendingleave": 1,
        "haslatestpayroll": true,
        "latestpayroll": {"period": "2026-07", "netsalary": "1,950.00", "currency": "USD", "paymentstatus": "Paid"}
    }
}}
<div class="local-hrdepartment-my-summary">
    {{^hasprofile}}
    <div class="alert alert-info">
        {{#str}}noemployeerecord, local_hrdepartment{{/str}}
    </div>
    {{/hasprofile}}

    {{#hasprofile}}
    <div class="mb-3 text-muted">
        {{#str}}employeecode, local_hrdepartment{{/str}}: <strong>{{employeecode}}</strong>
        {{#designation}} &middot; {{designation}}{{/designation}}
    </div>

    <div class="row">
        <div class="col-lg-4 mb-3">
            <div class="card h-100">
                <div class="card-header">{{#str}}myattendancethismonth, local_hrdepartment{{/str}}</div>
                <div class="card-body">
                    <table class="table table-sm mb-0">
                        <tbody>
                            <tr>
                                <th scope="row">{{#str}}attendance_present, local_hrdepartment{{/str}}</th>
                                <td class="text-right">{{attendancepresent}}</td>
                            </tr>
                            <tr>
                                <th scope="row">{{#str}}attendance_absent, local_hrdepartment{{/str}}</th>
                                <td class="text-right">{{attendanceabsent}}</td>
                            </tr>
                            <tr>
                                <th scope="row">{{#str}}attendance_leave, local_hrdepartment{{/str}}</th>
                                <td class="text-right">{{attendanceleave}}</td>
                            </tr>
                            <tr>
                                <th scope="row">{{#str}}attendance_halfday, local_hrdepartment{{/str}}</th>
                                <td class="text-right">{{attendancehalfday}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-3">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>{{#str}}myleavebalance, local_hrdepartment{{/str}}</span>
                    <span class="badge badge-secondary">{{#str}}pendingleave, local_hrdepartment{{/str}}: {{pendingleave}}</span>
                </div>
                {{#hasleavebalances}}
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>{{#str}}leavetype, local_hrdepartment{{/str}}</th>
                            <th class="text-right">{{#str}}allocated, local_hrdepartment{{/str}}</th>
                            <th class="text-right">{{#str}}used, local_hrdepartment{{/str}}</th>
                            <th class="text-right">{{#str}}remaining, local_hrdepartment{{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#leavebalances}}
                        <tr>
                            <td>{{leavetypename}}</td>
                            <td class="text-right">{{allocated}}</td>
                            <td class="text-right">{{used}}</td>
                            <td class="text-right">{{remaining}}</td>
                        </tr>
                        {{/leavebalances}}
                    </tbody>
                </table>
                {{/hasleavebalances}}
                {{^hasleavebalances}}
                <div class="card-body text-muted">{{#str}}noleavebalance, local_hrdepartment{{/str}}</div>
                {{/hasleavebalances}}
            </div>
        </div>

        <div class="col-lg-4 mb-3">
            <div class="card h-100">
                <div class="card-header">{{#str}}mylatestpayslip, local_hrdepartment{{/str}}</div>
                <div class="card-body">
                    {{#haslatestpayroll}}
                    <table class="table table-sm mb-0">
                        <tbody>
                            <tr>
                                <th scope="row">{{#str}}payrollperiod, local_hrdepartment{{/str}}</th>
                                <td class="text-right">{{latestpayroll.period}}</td>
                            </tr>
                            <tr>
                                <th scope="row">{{#str}}payrollnet, local_hrdepartment{{/str}}</th>
                                <td class="text-right">{{latestpayroll.currency}} {{latestpayroll.netsalary}}</td>
                            </tr>
                            <tr>
                                <th scope="row">{{#str}}paymentstatus, local_hrdepartment{{/str}}</th>
                                <td class="text-right">{{latestpayroll.paymentstatus}}</td>
                            </tr>
                        </tbody>
                    </table>
                    {{/haslatestpayroll}}
                    {{^haslatestpayroll}}
                    <div class="text-muted">{{#str}}nopayrollrecord, local_hrdepartment{{/str}}</div>
                    {{/haslatestpayroll}}
                </div>
            </div>
        </div>
    </div>
    {{/hasprofile}}
</div>
